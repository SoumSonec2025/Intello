{
    "builds": [{
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": {
            "distDir": "dist"
        }
    }],
    "routes": [{
            "src": "/app-ads.txt",
            "dest": "/app-ads.txt",
            "headers": {
                "Content-Type": "text/plain; charset=utf-8"
            }
        },
        {
            "src": "/((?!static|_next|assets|favicon.ico).*)",
            "dest": "/index.html"
        }
    ]
}